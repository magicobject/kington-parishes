/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-4RwqUYD4JP/ewBt0bVqlJ2A4I4YwLluTC3ZXzQNSUbs='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://tile.openstreetmap.org; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Advent calendar pictures: tighten only. Cloudflare applies this on top of the /* rule above and a
# browser enforces both policies, so the strictest wins. A picture may use inline styles and nothing else.
/advent/art/*
  Content-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; sandbox

# Keeps crawlers away from the Advent day files. It does not hide them: anyone who knows an address can still fetch it.
/advent/day-*.json
  X-Robots-Tag: noindex
