#!/bin/sh
# See scripts/pre-commit.mjs for the design and docs/hooks.md for the plain-English version.
# Checks the changelog entry, refuses to build from unstaged work, bumps the build number, rebuilds public/ and
# stages only the regenerated files. Escape hatch (one command only): HOOK_ALLOW_UNSTAGED=1 git commit ...
if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: COMMIT REFUSED: Node.js was not found on this program's PATH." >&2
  echo "  Start git from a terminal where  node --version  works (install Node 24 from nodejs.org if it does not)." >&2
  exit 1
fi
exec node scripts/pre-commit.mjs
