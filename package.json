{
  "name": "kington-parishes",
  "version": "1.0.0",
  "description": "Kington Parishes static site — feature tests for nav, contact details, footer credit and 404 handling.",
  "private": true,
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "node scripts/build.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "serve": "tsx test/support/static-server.ts",
    "typecheck": "tsc",
    "audit": "npm audit --audit-level=high"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicobject/kington-parishes.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/magicobject/kington-parishes/issues"
  },
  "homepage": "https://github.com/magicobject/kington-parishes#readme",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
